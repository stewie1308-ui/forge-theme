{%- comment -%}
  Schema.org structured data.
  Product rich snippet on product pages.
  Organization on all pages.
  BlogPosting on article pages.
{%- endcomment -%}

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    "description": {{ product.description | strip_html | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "sku": {{ product.selected_or_first_available_variant.sku | json }}
    {%- if product.featured_image -%}
      ,"image": [
        {%- for image in product.images limit: 5 -%}
          {{ image | image_url: width: 1200 | prepend: 'https:' | json }}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    {%- endif -%}
    ,"offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ variant.title | json }},
          "sku": {{ variant.sku | json }},
          "price": "{{ variant.price | divided_by: 100.0 }}",
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
          "url": {{ request.origin | append: product.url | append: '?variant=' | append: variant.id | json }}
        }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
    {%- liquid
      assign rating_raw   = product.metafields.reviews.rating.value
      assign rating_count = product.metafields.reviews.rating_count.value | default: 0
    -%}
    {%- comment -%}
      Both halves are required. Emitting aggregateRating with an invented reviewCount
      asserts review data to Google that does not exist, which is a rich-results
      penalty risk, so a rating with no count is not published at all.
    {%- endcomment -%}
    {%- if rating_raw != blank and rating_count > 0 -%}
      {%- assign rating_num = rating_raw.rating | default: rating_raw -%}
      ,"aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ rating_num | json }},
        "reviewCount": {{ rating_count | json }}
      }
    {%- endif -%}
  }
  </script>
{%- endif -%}

{%- if template.name == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "url": {{ request.origin | append: article.url | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateModified":  {{ article.updated_at  | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    }
    {%- if article.image -%}
      ,"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
    {%- endif -%}
  }
  </script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }}
  {%- if settings.brand_logo != blank -%}
    ,"logo": {{ settings.brand_logo | image_url: width: 400 | prepend: 'https:' | json }}
  {%- endif -%}
}
</script>
