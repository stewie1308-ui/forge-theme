<div class="password-page">
  <div class="password-page__inner">

    {%- if section.settings.logo != blank -%}
      <img
        class="password-page__logo"
        src="{{ section.settings.logo | image_url: width: 400 }}"
        alt="{{ shop.name | escape }}"
        width="{{ section.settings.logo_max_width }}"
        height="{{ section.settings.logo_max_width | times: section.settings.logo.height | divided_by: section.settings.logo.width }}"
        loading="eager"
      >
    {%- else -%}
      <h1 class="password-page__shop-name">{{ shop.name }}</h1>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="password-page__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="password-page__sub rte">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {{- '<!-- Newsletter signup -->' -}}
    {%- form 'customer', id: 'PasswordNewsletter' -%}
      {%- if form.posted_successfully? -%}
        <p class="account-form__success" role="status">
          {{ 'general.password_page.signup_form_success' | t }}
        </p>
      {%- else -%}
        {%- if form.errors -%}
          <div class="account-form__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <input type="hidden" name="contact[tags]" value="prerelease">
        <div class="password-page__form">
          <label class="sr-only" for="PasswordNewsletterEmail">
            {{ 'general.password_page.signup_form_email_label' | t }}
          </label>
          <input
            id="PasswordNewsletterEmail"
            type="email"
            name="contact[email]"
            class="form-input"
            placeholder="{{ 'general.password_page.signup_form_email_label' | t }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
          >
          <button type="submit" class="btn btn--primary">
            {{ 'general.password_page.login_form_submit' | t }}
          </button>
        </div>
      {%- endif -%}
    {%- endform -%}

    {{- '<!-- Store password -->' -}}
    <div class="password-page__enter">
      <button
        type="button"
        class="password-page__toggle"
        aria-expanded="false"
        aria-controls="PasswordLoginForm"
        id="PasswordLoginToggle"
      >
        {{ 'general.password_page.login_form_heading' | t }}
      </button>

      <div id="PasswordLoginForm" hidden>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <div class="account-form__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div class="password-page__form">
            <label class="sr-only" for="StorefrontPassword">
              {{ 'general.password_page.login_form_password_label' | t }}
            </label>
            <input
              id="StorefrontPassword"
              type="password"
              name="password"
              class="form-input"
              placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
              autocomplete="current-password"
              required
            >
            <button type="submit" class="btn btn--primary">
              {{ 'general.password_page.login_form_submit' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>

    <p class="password-page__admin">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>

  </div>
</div>

<script>
(function () {
  var toggle = document.getElementById('PasswordLoginToggle');
  var panel  = document.getElementById('PasswordLoginForm');
  if (!toggle || !panel) return;

  /* Shopify re-renders with form errors when the password is wrong,
     so open the panel straight away in that case. */
  if (panel.querySelector('.account-form__errors')) {
    panel.removeAttribute('hidden');
    toggle.setAttribute('aria-expanded', 'true');
  }

  toggle.addEventListener('click', function () {
    var isOpen = !panel.hidden;
    if (isOpen) {
      panel.setAttribute('hidden', '');
    } else {
      panel.removeAttribute('hidden');
      var field = document.getElementById('StorefrontPassword');
      if (field) field.focus();
    }
    toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
  });
}());
</script>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.main-password.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "t:sections.main-password.settings.logo_max_width.label",
      "min": 80,
      "max": 320,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main-password.settings.heading.label",
      "default": "Something big is coming"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.main-password.settings.subheading.label",
      "default": "<p>Be the first to know when we launch.</p>"
    }
  ]
}
{% endschema %}
