{%- liquid
  # A block with no heading and no text still draws a card — only the icon would
  # be left in it. Skip those, and hide the section when nothing survives, so a
  # merchant who clears the placeholder copy gets nothing rather than a row of
  # empty boxes. Same convention as the testimonials section.
  assign has_items = false
  for block in section.blocks
    if block.settings.heading != blank or block.settings.text != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- if has_items -%}
<section class="section{% if section.settings.bg_dark %} bg-dark{% elsif section.settings.bg_secondary %} bg-secondary{% endif %}">
  <div class="container">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading section-heading--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="benefits-grid benefits-grid--{{ section.settings.columns }} stagger">
      {%- for block in section.blocks -%}
        {%- if block.settings.heading == blank and block.settings.text == blank -%}{%- continue -%}{%- endif -%}
        <div class="benefit-item benefit-item--{{ section.settings.style }}" {{ block.shopify_attributes }}>

          {%- if section.settings.style == 'icon' -%}
            <div class="benefit-item__icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                <span style="font-size:1.5rem;line-height:1;">{{ block.settings.icon }}</span>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
              {%- endif -%}
            </div>

          {%- elsif section.settings.style == 'number' -%}
            <div class="benefit-item__number" aria-hidden="true">{{ forloop.index }}</div>

          {%- elsif section.settings.style == 'image' and block.settings.image != blank -%}
            <div class="benefit-item__img-wrap">
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="lazy"
                width="400"
                height="300"
                style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-md);"
              >
            </div>
          {%- endif -%}

          <div class="benefit-item__body">
            {%- if block.settings.heading != blank -%}
              <h3 class="benefit-item__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="benefit-item__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="benefit-item__link">
                {{ block.settings.link_label }}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>
{%- endif -%}


{% schema %}
{
  "name": "t:sections.benefits.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.benefits.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.benefits.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.benefits.settings.heading.label",
      "default": "Why Forge?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.benefits.settings.subheading.label"
    },
    {
      "type": "header",
      "content": "t:sections.benefits.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.benefits.settings.style.label",
      "options": [
        {
          "value": "icon",
          "label": "t:sections.benefits.settings.style.options__1.label"
        },
        {
          "value": "number",
          "label": "t:sections.benefits.settings.style.options__2.label"
        },
        {
          "value": "inline",
          "label": "t:sections.benefits.settings.style.options__3.label"
        },
        {
          "value": "image",
          "label": "t:sections.benefits.settings.style.options__4.label"
        }
      ],
      "default": "icon"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.benefits.settings.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.benefits.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "bg_secondary",
      "label": "t:sections.benefits.settings.bg_secondary.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bg_dark",
      "label": "t:sections.benefits.settings.bg_dark.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.benefits.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "t:sections.benefits.blocks.item.settings.icon.label",
          "info": "t:sections.benefits.blocks.item.settings.icon.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.benefits.blocks.item.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.benefits.blocks.item.settings.heading.label",
          "info": "t:sections.benefits.blocks.item.settings.heading.info",
          "placeholder": "t:sections.benefits.blocks.item.settings.heading.placeholder"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.benefits.blocks.item.settings.text.label",
          "placeholder": "t:sections.benefits.blocks.item.settings.text.placeholder"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.benefits.blocks.item.settings.link_label.label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:sections.benefits.blocks.item.settings.link_url.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.benefits.presets.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "🧪",
            "heading": "",
            "text": ""
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "🔬",
            "heading": "",
            "text": ""
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "🌿",
            "heading": "",
            "text": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
