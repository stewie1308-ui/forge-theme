<section class="section{% if section.settings.bg_dark %} bg-dark{% elsif section.settings.bg_secondary %} bg-secondary{% endif %}">
  <div class="container">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading section-heading--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="benefits-grid benefits-grid--{{ section.settings.columns }} stagger">
      {%- for block in section.blocks -%}
        <div class="benefit-item benefit-item--{{ section.settings.style }}" {{ block.shopify_attributes }}>

          {%- if section.settings.style == 'icon' -%}
            <div class="benefit-item__icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                <span style="font-size:1.5rem;line-height:1;">{{ block.settings.icon }}</span>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
              {%- endif -%}
            </div>

          {%- elsif section.settings.style == 'number' -%}
            <div class="benefit-item__number" aria-hidden="true">{{ forloop.index }}</div>

          {%- elsif section.settings.style == 'image' and block.settings.image != blank -%}
            <div class="benefit-item__img-wrap">
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="lazy"
                width="400"
                height="300"
                style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-md);"
              >
            </div>
          {%- endif -%}

          <div class="benefit-item__body">
            {%- if block.settings.heading != blank -%}
              <h3 class="benefit-item__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="benefit-item__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="benefit-item__link">
                {{ block.settings.link_label }}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Forge?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "options": [
        { "value": "icon",   "label": "Icon cards" },
        { "value": "number", "label": "Numbered list" },
        { "value": "inline", "label": "Inline (no card)" },
        { "value": "image",  "label": "Image cards" }
      ],
      "default": "icon"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "checkbox",
      "id": "bg_secondary",
      "label": "Secondary background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bg_dark",
      "label": "Dark background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or SVG)",
          "info": "Paste an emoji e.g. 🧪 or leave blank for default tick"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (image style only)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Clinically dosed"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every ingredient is included at the dose used in peer-reviewed research — no fairy dusting."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "🧪",
            "heading": "Clinically dosed",
            "text": "Every ingredient at the dose used in peer-reviewed research. No fairy dusting."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "🔬",
            "heading": "Third-party tested",
            "text": "Every batch tested by an independent ISO-accredited laboratory for purity and potency."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "🌿",
            "heading": "Clean label",
            "text": "No artificial colours, fillers or proprietary blends. You know exactly what you're putting in your body."
          }
        }
      ]
    }
  ]
}
{% endschema %}
