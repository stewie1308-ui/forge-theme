{%- liquid
  # A block with no review text still draws a card: the author footer and the
  # initials avatar render regardless, so a blank block leaves an empty box.
  # Skip those, and hide the section when nothing is left — the same convention
  # the aggregate already uses, where blanking the figures removes the block
  # rather than leaving a gap.
  assign has_reviews = false
  for block in section.blocks
    if block.settings.quote != blank
      assign has_reviews = true
      break
    endif
  endfor

  assign has_aggregate = false
  if section.settings.show_aggregate and section.settings.aggregate_rating != blank
    assign has_aggregate = true
  endif
-%}

{%- if has_reviews or has_aggregate -%}
<section class="section{% if section.settings.bg_secondary %} bg-secondary{% elsif section.settings.bg_dark %} bg-dark{% endif %}">
  <div class="container">

    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_aggregate and section.settings.aggregate_rating != blank -%}
      <div class="testimonials-aggregate reveal">
        <div class="testimonials-aggregate__stars" aria-hidden="true">
          {%- assign rating = section.settings.aggregate_rating | times: 1 | round -%}
          {%- for i in (1..5) -%}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="{% if i <= rating %}0{% else %}1.5{% endif %}" style="color:#f59e0b" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          {%- endfor -%}
        </div>
        <p class="testimonials-aggregate__score">
          {{ 'sections.testimonials.rating_html' | t: rating: section.settings.aggregate_rating }}
        </p>
        {%- if section.settings.review_count != blank -%}
          <p class="testimonials-aggregate__count">{{ 'sections.testimonials.based_on_reviews' | t: count: section.settings.review_count }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="testimonials-grid stagger">
      {%- for block in section.blocks -%}
        {%- if block.settings.quote == blank -%}{%- continue -%}{%- endif -%}
        <article class="testimonial-card" {{ block.shopify_attributes }}>

          {%- if block.settings.rating > 0 -%}
            <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="{% if i <= block.settings.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="{% if i <= block.settings.rating %}0{% else %}1.5{% endif %}" style="color:#f59e0b" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.quote != blank -%}
            <blockquote class="testimonial-card__quote">
              &ldquo;{{ block.settings.quote }}&rdquo;
            </blockquote>
          {%- endif -%}

          <footer class="testimonial-card__author">
            {%- if block.settings.avatar != blank -%}
              <img
                class="testimonial-card__avatar"
                src="{{ block.settings.avatar | image_url: width: 80 }}"
                alt="{{ block.settings.name | default: 'Customer' | escape }}"
                loading="lazy"
                width="40"
                height="40"
              >
            {%- else -%}
              <div class="testimonial-card__avatar testimonial-card__avatar--initials" aria-hidden="true">
                {{ block.settings.name | slice: 0, 1 | upcase }}
              </div>
            {%- endif -%}

            <div>
              {%- if block.settings.name != blank -%}
                <p class="testimonial-card__name">{{ block.settings.name }}</p>
              {%- endif -%}
              {%- if block.settings.meta != blank -%}
                <p class="testimonial-card__meta">{{ block.settings.meta }}</p>
              {%- endif -%}
            </div>

            {%- if block.settings.verified -%}
              <span class="testimonial-card__verified" title="{{ 'products.product.verified_purchase' | t }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"/></svg>
                Verified
              </span>
            {%- endif -%}
          </footer>

          {%- if block.settings.product != blank -%}
            <a href="{{ block.settings.product.url }}" class="testimonial-card__product">
              {{ block.settings.product.title }}
            </a>
          {%- endif -%}

        </article>
      {%- endfor -%}
    </div>

  </div>
</section>
{%- endif -%}


{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.testimonials.settings.eyebrow.label",
      "default": "Real results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading.label",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.testimonials.settings.subheading.label"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "show_aggregate",
      "label": "t:sections.testimonials.settings.show_aggregate.label",
      "default": true
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "t:sections.testimonials.settings.aggregate_rating.label",
      "info": "t:sections.testimonials.settings.aggregate_rating.info",
      "placeholder": "t:sections.testimonials.settings.aggregate_rating.placeholder"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "t:sections.testimonials.settings.review_count.label",
      "info": "t:sections.testimonials.settings.review_count.info",
      "placeholder": "t:sections.testimonials.settings.review_count.placeholder"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "bg_secondary",
      "label": "t:sections.testimonials.settings.bg_secondary.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bg_dark",
      "label": "t:sections.testimonials.settings.bg_dark.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.testimonials.blocks.review.name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.blocks.review.settings.rating.label",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.review.settings.quote.label",
          "info": "t:sections.testimonials.blocks.review.settings.quote.info",
          "placeholder": "t:sections.testimonials.blocks.review.settings.quote.placeholder"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:sections.testimonials.blocks.review.settings.avatar.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.testimonials.blocks.review.settings.name.label",
          "placeholder": "t:sections.testimonials.blocks.review.settings.name.placeholder"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "t:sections.testimonials.blocks.review.settings.meta.label",
          "placeholder": "t:sections.testimonials.blocks.review.settings.meta.placeholder"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "t:sections.testimonials.blocks.review.settings.verified.label",
          "info": "t:sections.testimonials.blocks.review.settings.verified.info",
          "default": false
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.testimonials.blocks.review.settings.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "",
            "name": "",
            "meta": "",
            "verified": false
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "",
            "name": "",
            "meta": "",
            "verified": false
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "",
            "name": "",
            "meta": "",
            "verified": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
