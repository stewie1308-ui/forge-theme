{%- liquid
  assign products_source = section.settings.products_source
  assign cols = section.settings.columns | default: 4

  comment
    A 'collection' source with no collection chosen used to fall straight through to
    the skeleton placeholders below — and those shipped to the live storefront, not
    just the editor. Fall back to the automatic 'all' collection instead, so an
    unconfigured section shows real products.
  endcomment
  assign fp_collection = section.settings.collection
  if products_source == 'collection' and fp_collection == blank
    assign fp_collection = collections['all']
  endif

  comment
    Placeholders are now shown only when there is genuinely nothing to render —
    a new store with no products, which is the editor case they were written for.
  endcomment
  assign fp_has_products = false
  if products_source == 'manual'
    for block in section.blocks
      if block.settings.product != blank
        assign fp_has_products = true
        break
      endif
    endfor
  elsif fp_collection.products.size > 0
    assign fp_has_products = true
  endif
-%}

<section class="section{% if section.settings.bg_secondary %} bg-secondary{% endif %}">
  <div class="container">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading{% if section.settings.heading_align == 'center' %} section-heading--center{% endif %} reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fp-grid fp-grid--{{ cols }} stagger">
      {%- if fp_has_products == false -%}
        {%- comment -%} Nothing to show yet — skeletons while the merchant sets up {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div class="product-card product-card--placeholder">
            <div class="product-card__media">
              <div class="product-card__placeholder" style="background:var(--color-background-secondary);aspect-ratio:1;"></div>
            </div>
            <div class="product-card__body">
              <div class="skeleton" style="height:14px;width:60%;margin-bottom:8px;"></div>
              <div class="skeleton" style="height:20px;width:80%;margin-bottom:8px;"></div>
              <div class="skeleton" style="height:14px;width:40%;"></div>
            </div>
          </div>
        {%- endfor -%}

      {%- elsif products_source == 'manual' -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- render 'product-card',
              product: block.settings.product,
              show_quick_add: section.settings.show_quick_add
            -%}
          {%- endif -%}
        {%- endfor -%}

      {%- else -%}
        {%- for product in fp_collection.products limit: section.settings.products_limit -%}
          {%- render 'product-card',
            product: product,
            show_quick_add: section.settings.show_quick_add
          -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="fp-cta reveal" style="text-align:{{ section.settings.heading_align | default: 'center' }}">
        <a
          href="{{ section.settings.cta_link | default: '/collections/all' }}"
          class="btn btn--secondary btn--lg"
        >
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>


{% schema %}
{
  "name": "t:sections.featured-products.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured-products.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured-products.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-products.settings.heading.label",
      "default": "Our bestsellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.featured-products.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.featured-products.settings.heading_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured-products.settings.heading_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.featured-products.settings.heading_align.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.featured-products.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "products_source",
      "label": "t:sections.featured-products.settings.products_source.label",
      "options": [
        {
          "value": "collection",
          "label": "t:sections.featured-products.settings.products_source.options__1.label"
        },
        {
          "value": "manual",
          "label": "t:sections.featured-products.settings.products_source.options__2.label"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-products.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "t:sections.featured-products.settings.products_limit.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured-products.settings.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.featured-products.settings.show_quick_add.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured-products.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "bg_secondary",
      "label": "t:sections.featured-products.settings.bg_secondary.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.featured-products.settings.header__4.content"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.featured-products.settings.cta_label.label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.featured-products.settings.cta_link.label"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.featured-products.blocks.product.name",
      "limit": 12,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.featured-products.blocks.product.settings.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-products.presets.name"
    }
  ]
}
{% endschema %}
