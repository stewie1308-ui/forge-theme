{%- assign search_performed = false -%}
{%- if search.performed -%}
  {%- assign search_performed = true -%}
{%- endif -%}

<section class="search-section">
  <div class="container">

    <!-- Search form -->
    <div class="search-header reveal">
      <h1 class="search-header__title">
        {%- if search_performed -%}
          Results for &ldquo;{{ search.terms | escape }}&rdquo;
        {%- else -%}
          Search
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
        <input type="hidden" name="type" value="{{ section.settings.search_type }}">
        <div class="search-form__inner">
          <label class="sr-only" for="SearchPageInput">{{ 'general.search.title' | t }}</label>
          <input
            id="SearchPageInput"
            class="form-input search-form__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
            autocomplete="off"
            autofocus
          >
          <button type="submit" class="btn btn--primary search-form__btn" aria-label="{{ 'general.search.submit' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
            {{ 'general.search.submit' | t }}
          </button>
        </div>
      </form>
    </div>

    {%- if search_performed -%}

      {%- if search.results_count == 0 -%}
        <div class="search-no-results">
          <p>{{ 'general.search.no_results_html' | t: terms: search.terms }}</p>
          <p class="text-muted mt-4">{{ 'general.search.no_results_hint' | t }}</p>
        </div>

      {%- else -%}

        <p class="search-results-count">
          {%- if search.terms != blank -%}
            {{ 'general.search.results_for_html' | t: count: search.results_count, terms: search.terms }}
          {%- else -%}
            {{ 'general.search.results_with_count' | t: count: search.results_count }}
          {%- endif -%}
        </p>

        {%- paginate search.results by section.settings.results_per_page -%}

          <div class="search-results-grid">
            {%- for item in search.results -%}

              {%- case item.object_type -%}

                {%- when 'product' -%}
                  {%- render 'product-card', product: item, show_quick_add: true -%}

                {%- when 'article' -%}
                  <article class="search-result-card search-result-card--article">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" class="search-result-card__img-wrap" tabindex="-1">
                        <img
                          src="{{ item.image | image_url: width: 600 }}"
                          alt="{{ item.image.alt | default: item.title | escape }}"
                          loading="lazy"
                          width="600"
                          height="400"
                          style="width:100%;aspect-ratio:3/2;object-fit:cover;"
                        >
                      </a>
                    {%- endif -%}
                    <div class="search-result-card__body">
                      <p class="label">{{ item.type | capitalize }}</p>
                      <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      {%- if item.excerpt != blank -%}
                        <p class="text-muted text-sm">{{ item.excerpt | strip_html | truncate: 120 }}</p>
                      {%- endif -%}
                    </div>
                  </article>

                {%- when 'page' -%}
                  <article class="search-result-card search-result-card--page">
                    <div class="search-result-card__body">
                      <p class="label">{{ item.type | capitalize }}</p>
                      <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      {%- if item.content != blank -%}
                        <p class="text-muted text-sm">{{ item.content | strip_html | truncate: 120 }}</p>
                      {%- endif -%}
                    </div>
                  </article>

              {%- endcase -%}

            {%- endfor -%}
          </div>

          {%- render 'pagination', paginate: paginate -%}

        {%- endpaginate -%}

      {%- endif -%}

    {%- endif -%}

  </div>
</section>


{% schema %}
{
  "name": "t:sections.main-search.name",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:sections.main-search.settings.results_per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "search_type",
      "label": "t:sections.main-search.settings.search_type.label",
      "options": [
        {
          "value": "product,article,page",
          "label": "t:sections.main-search.settings.search_type.options__1.label"
        },
        {
          "value": "product",
          "label": "t:sections.main-search.settings.search_type.options__2.label"
        },
        {
          "value": "product,article",
          "label": "t:sections.main-search.settings.search_type.options__3.label"
        }
      ],
      "default": "product,article,page"
    }
  ]
}
{% endschema %}
