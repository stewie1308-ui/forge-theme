<section class="account-section">
  <div class="container">
    <div class="account-form-wrap reveal">
      <h1 class="account-form__title">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="account-form__alt" style="text-align:left;margin-top:0;margin-bottom:1.5rem;">
        {{ 'customer.activate_account.subtext' | t }}
      </p>

      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="account-form__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group">
          <label class="form-label" for="ActivatePassword">
            {{ 'customer.activate_account.password' | t }}
          </label>
          <input
            id="ActivatePassword"
            type="password"
            name="customer[password]"
            class="form-input"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="form-group mt-4">
          <label class="form-label" for="ActivatePasswordConfirm">
            {{ 'customer.activate_account.password_confirm' | t }}
          </label>
          <input
            id="ActivatePasswordConfirm"
            type="password"
            name="customer[password_confirmation]"
            class="form-input"
            autocomplete="new-password"
            required
          >
        </div>

        <button type="submit" class="btn btn--primary btn--full btn--lg mt-6">
          {{ 'customer.activate_account.submit' | t }}
        </button>

        <button type="submit" name="decline" class="btn btn--secondary btn--full mt-4">
          {{ 'customer.activate_account.cancel' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
