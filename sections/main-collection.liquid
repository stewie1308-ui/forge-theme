{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

{%- render 'breadcrumbs' -%}

<section class="collection-section">
  <div class="container">

    <!-- Collection header -->
    <div class="collection-header reveal">
      <div class="collection-header__text">
        <h1 class="collection-header__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="collection-header__desc rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_product_count -%}
        <p class="collection-header__count">
          {{ collection.products_count }}
          {%- if collection.products_count == 1 %} product{%- else %} products{%- endif -%}
        </p>
      {%- endif -%}
    </div>

    <!-- Toolbar: filters toggle + sort -->
    <div class="collection-toolbar">
      {%- if section.settings.enable_filtering -%}
        <button
          class="btn btn--secondary btn--sm collection-toolbar__filter-btn"
          aria-expanded="false"
          aria-controls="CollectionFilters"
          id="FilterToggle"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/></svg>
          Filter
          {%- assign active_count = 0 -%}
          {%- for filter in collection.filters -%}
            {%- assign active_count = active_count | plus: filter.active_values.size -%}
          {%- endfor -%}
          {%- if active_count > 0 -%}
            <span class="collection-toolbar__filter-count">{{ active_count }}</span>
          {%- endif -%}
        </button>
      {%- endif -%}

      <div class="collection-toolbar__right">
        {%- if section.settings.enable_sorting -%}
          <div class="collection-sort">
            <label class="collection-sort__label" for="SortBy">{{ 'collections.sort_by' | t }}</label>
            <select
              id="SortBy"
              class="form-select collection-sort__select"
              name="sort_by"
              aria-describedby="a11y-refresh-page-message"
              data-collection-sort
            >
              {%- assign sort_options = collection.sort_options -%}
              {%- for option in sort_options -%}
                <option
                  value="{{ option.value }}"
                  {% if option.value == sort_by %}selected{% endif %}
                >
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        {%- if section.settings.show_grid_toggle -%}
          <div class="collection-view-toggle" role="group" aria-label="{{ 'collections.grid_view' | t }}">
            <button class="collection-view-btn is-active" data-cols="4" aria-pressed="true" aria-label="{{ 'collections.columns_count' | t: count: 4 }}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="3" height="3"/><rect x="6" y="1" width="3" height="3"/><rect x="11" y="1" width="3" height="3"/><rect x="1" y="6" width="3" height="3"/><rect x="6" y="6" width="3" height="3"/><rect x="11" y="6" width="3" height="3"/></svg>
            </button>
            <button class="collection-view-btn" data-cols="2" aria-pressed="false" aria-label="{{ 'collections.columns_count' | t: count: 2 }}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6"/><rect x="9" y="1" width="6" height="6"/><rect x="1" y="9" width="6" height="6"/><rect x="9" y="9" width="6" height="6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="collection-layout">

      <!-- Filters sidebar -->
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        <aside
          id="CollectionFilters"
          class="collection-filters"
          aria-label="{{ 'collections.product_filters' | t }}"
        >
          <form id="FiltersForm" action="{{ collection.url }}" method="get">

            {%- comment -%} Preserve sort_by {%- endcomment -%}
            <input type="hidden" name="sort_by" value="{{ sort_by }}">

            {%- if active_count > 0 -%}
              <div class="collection-filters__header">
                <p class="collection-filters__title">{{ 'collections.filters' | t }}</p>
                <a href="{{ collection.url }}" class="collection-filters__clear">{{ 'collections.clear_all' | t }}</a>
              </div>
            {%- else -%}
              <p class="collection-filters__title">{{ 'collections.filters' | t }}</p>
            {%- endif -%}

            {%- for filter in collection.filters -%}
              <details class="filter-group" {% if filter.active_values.size > 0 %}open{% endif %}>
                <summary class="filter-group__summary">
                  {{ filter.label }}
                  {%- if filter.active_values.size > 0 -%}
                    <span class="filter-group__active-count">{{ filter.active_values.size }}</span>
                  {%- endif -%}
                  <svg class="filter-group__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
                </summary>

                <div class="filter-group__body">
                  {%- case filter.type -%}

                    {%- when 'boolean', 'list' -%}
                      <ul class="filter-list" role="list">
                        {%- for value in filter.values -%}
                          <li class="filter-list__item">
                            <label class="filter-checkbox" for="Filter-{{ filter.param_name }}-{{ forloop.index }}">
                              <input
                                type="checkbox"
                                id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                                name="{{ filter.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                class="filter-checkbox__input"
                              >
                              <span class="filter-checkbox__box" aria-hidden="true"></span>
                              <span class="filter-checkbox__label">{{ value.label }}</span>
                              <span class="filter-checkbox__count">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>

                    {%- when 'price_range' -%}
                      <div class="filter-price">
                        <div class="filter-price__inputs">
                          <div class="form-group">
                            <label class="form-label" for="Filter-{{ filter.param_name }}-min">
                              Min price ({{ cart.currency.symbol }})
                            </label>
                            <input
                              type="number"
                              id="Filter-{{ filter.param_name }}-min"
                              name="{{ filter.min_value.param_name }}"
                              class="form-input"
                              {%- if filter.min_value.value -%}
                                value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                              {%- endif -%}
                              placeholder="0"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            >
                          </div>
                          <div class="form-group">
                            <label class="form-label" for="Filter-{{ filter.param_name }}-max">
                              Max price ({{ cart.currency.symbol }})
                            </label>
                            <input
                              type="number"
                              id="Filter-{{ filter.param_name }}-max"
                              name="{{ filter.max_value.param_name }}"
                              class="form-input"
                              {%- if filter.max_value.value -%}
                                value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                              {%- endif -%}
                              placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            >
                          </div>
                        </div>
                      </div>

                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}

            <button type="submit" class="btn btn--primary btn--full mt-6">{{ 'collections.apply_filters' | t }}</button>

          </form>
        </aside>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="collection-app-block" {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Product grid -->
      <div class="collection-products">
        {%- paginate collection.products by products_per_page -%}

          {%- if collection.products.size == 0 -%}
            <div class="collection-empty">
              <p>{{ 'collections.no_products' | t }}</p>
              {%- if active_count > 0 -%}
                <a href="{{ collection.url }}" class="btn btn--secondary mt-4">{{ 'collections.clear_filters' | t }}</a>
              {%- endif -%}
            </div>
          {%- else -%}
            <div
              class="collection-grid"
              id="ProductGrid"
              data-cols="{{ section.settings.columns_desktop }}"
            >
              {%- for product in collection.products -%}
                {%- render 'product-card',
                  product: product,
                  show_quick_add: section.settings.show_quick_add
                -%}
              {%- endfor -%}
            </div>

            {%- render 'pagination', paginate: paginate -%}
          {%- endif -%}

        {%- endpaginate -%}
      </div>

    </div>
  </div>
</section>


<script>
(function () {

  /* Sort — redirect on change */
  var sortSelect = document.querySelector('[data-collection-sort]');
  if (sortSelect) {
    sortSelect.addEventListener('change', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', sortSelect.value);
      window.location.href = url.toString();
    });
  }

  /* Filter panel toggle (mobile) */
  var filterToggle = document.getElementById('FilterToggle');
  var filterPanel  = document.getElementById('CollectionFilters');

  if (filterToggle && filterPanel) {
    var filterOverlay = document.createElement('div');
    filterOverlay.className = 'mobile-nav-overlay';
    filterOverlay.setAttribute('aria-hidden', 'true');
    document.body.appendChild(filterOverlay);

    filterToggle.addEventListener('click', function () {
      var isOpen = filterPanel.classList.contains('is-open');
      filterPanel.classList.toggle('is-open', !isOpen);
      filterToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      filterOverlay.classList.toggle('is-visible', !isOpen);
      document.body.classList.toggle('no-scroll', !isOpen);
    });

    filterOverlay.addEventListener('click', function () {
      filterPanel.classList.remove('is-open');
      filterToggle.setAttribute('aria-expanded', 'false');
      filterOverlay.classList.remove('is-visible');
      document.body.classList.remove('no-scroll');
    });
  }

  /* Grid view toggle */
  document.querySelectorAll('.collection-view-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cols = btn.dataset.cols;
      var grid = document.getElementById('ProductGrid');
      if (grid) {
        grid.dataset.cols = cols;
        grid.style.gridTemplateColumns = 'repeat(' + cols + ', 1fr)';
      }
      document.querySelectorAll('.collection-view-btn').forEach(function (b) {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');
    });
  });

  /* Auto-submit filters on checkbox change */
  var filtersForm = document.getElementById('FiltersForm');
  if (filtersForm) {
    filtersForm.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
      cb.addEventListener('change', function () {
        filtersForm.submit();
      });
    });
  }

}());
</script>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Filtering & sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "Requires filters set up in Shopify admin — Search & Discovery app",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_grid_toggle",
      "label": "Show grid view toggle",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "enabled_on": {
    "templates": [
      "collection"
    ]
  }
}
{% endschema %}
