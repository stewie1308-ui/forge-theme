<section class="account-section account-section--dashboard">
  <div class="container">

    <div class="account-header reveal">
      <div>
        <h1 class="account-header__title">{{ 'customer.account.title' | t }}</h1>
        <p class="account-header__name">{{ customer.name }}</p>
      </div>
      <a href="{{ routes.account_logout_url }}" class="btn btn--secondary btn--sm">{{ 'customer.account.log_out' | t }}</a>
    </div>

    <div class="account-layout">

      <!-- Orders -->
      <div class="account-orders reveal">
        <h2 class="account-section__heading">{{ 'customer.orders.title' | t }}</h2>

        {%- if customer.orders.size == 0 -%}
          <p class="account-empty">{{ 'customer.orders.none' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary mt-4">{{ 'customer.account.start_shopping' | t }}</a>
        {%- else -%}
          <table class="orders-table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment_status' | t }}</th>
                <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="orders-table__order-link">{{ order.name }}</a></td>
                  <td><time datetime="{{ order.created_at | date: '%Y-%m-%d' }}">{{ order.created_at | date: '%d %b %Y' }}</time></td>
                  <td><span class="order-badge order-badge--{{ order.financial_status }}">{{ order.financial_status_label }}</span></td>
                  <td><span class="order-badge order-badge--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label | default: 'Unfulfilled' }}</span></td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- endif -%}
      </div>

      <!-- Address -->
      <aside class="account-address reveal">
        <h2 class="account-section__heading">{{ 'customer.account.default_address' | t }}</h2>
        {%- if customer.default_address -%}
          <address class="account-address__display">
            {{ customer.default_address | format_address }}
          </address>
        {%- else -%}
          <p class="account-empty">{{ 'customer.account.no_address' | t }}</p>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="btn btn--secondary btn--sm mt-4" style="display:inline-flex;">{{ 'customer.account.manage_addresses' | t }}</a>
      </aside>

    </div>
  </div>
</section>


{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
