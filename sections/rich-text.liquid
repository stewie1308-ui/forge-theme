<section class="section{% if section.settings.bg_secondary %} bg-secondary{% elsif section.settings.bg_dark %} bg-dark{% endif %}">
  <div class="container">
    <div class="rich-text rich-text--{{ section.settings.width }} reveal">

      {%- if section.settings.eyebrow != blank -%}
        <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rich-text__body rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="rich-text__buttons">
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="btn btn--{{ section.settings.button_style }} btn--lg"
          >
            {{ section.settings.button_label }}
          </a>
          {%- if section.settings.button_label_2 != blank -%}
            <a
              href="{{ section.settings.button_link_2 | default: '#' }}"
              class="btn btn--{{ section.settings.button_style_2 }}"
            >
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>


{% schema %}
{
  "name": "t:sections.rich-text.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.rich-text.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.rich-text.settings.heading.label",
      "default": "Our promise to you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.rich-text.settings.text.label",
      "info": "t:sections.rich-text.settings.text.info",
      "default": "<p>Tell customers what your brand stands for.</p>"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.rich-text.settings.width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:sections.rich-text.settings.width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.rich-text.settings.width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.rich-text.settings.width.options__3.label"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "t:sections.rich-text.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.rich-text.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.rich-text.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.rich-text.settings.button_style.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.rich-text.settings.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.rich-text.settings.button_style.options__2.label"
        },
        {
          "value": "accent",
          "label": "t:sections.rich-text.settings.button_style.options__3.label"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "t:sections.rich-text.settings.header__2.content"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.rich-text.settings.button_label_2.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.rich-text.settings.button_link_2.label"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "t:sections.rich-text.settings.button_style_2.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.rich-text.settings.button_style_2.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.rich-text.settings.button_style_2.options__2.label"
        },
        {
          "value": "accent",
          "label": "t:sections.rich-text.settings.button_style_2.options__3.label"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "t:sections.rich-text.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "bg_secondary",
      "label": "t:sections.rich-text.settings.bg_secondary.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bg_dark",
      "label": "t:sections.rich-text.settings.bg_dark.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name"
    }
  ]
}
{% endschema %}
