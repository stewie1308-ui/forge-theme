<section class="account-section">
  <div class="container">
    <div class="account-form-wrap reveal">
      <h1 class="account-form__title">{{ 'customer.register.title' | t }}</h1>

      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="account-form__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="form-group">
          <label class="form-label" for="FirstName">{{ 'customer.register.first_name' | t }}</label>
          <input id="FirstName" type="text" name="customer[first_name]" class="form-input" autocomplete="given-name" value="{{ form.first_name }}">
        </div>
        <div class="form-group mt-4">
          <label class="form-label" for="LastName">{{ 'customer.register.last_name' | t }}</label>
          <input id="LastName" type="text" name="customer[last_name]" class="form-input" autocomplete="family-name" value="{{ form.last_name }}">
        </div>
        <div class="form-group mt-4">
          <label class="form-label" for="Email">{{ 'customer.register.email' | t }}</label>
          <input id="Email" type="email" name="customer[email]" class="form-input" autocomplete="email" value="{{ form.email }}" required>
        </div>
        <div class="form-group mt-4">
          <label class="form-label" for="CreatePassword">{{ 'customer.register.password' | t }}</label>
          <input id="CreatePassword" type="password" name="customer[password]" class="form-input" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full btn--lg mt-6">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}

      <p class="account-form__alt">
        {{ 'customer.register.login' | t }}
        <a href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": []
}
{% endschema %}
