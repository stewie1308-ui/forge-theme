{%- render 'breadcrumbs' -%}

<section class="page-section">
  <div class="container container--narrow">
    <div class="page-header reveal">
      <h1 class="page-header__title">{{ page.title }}</h1>
    </div>
    <div class="page-content rte reveal">
      {{ page.content }}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "t:sections.main-page.name",
  "settings": []
}
{% endschema %}
