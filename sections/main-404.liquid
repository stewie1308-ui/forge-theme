<section class="not-found-section">
  <div class="container">
    <div class="not-found reveal">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1 class="not-found__title">{{ '404.title' | t }}</h1>
      <p class="not-found__text">{{ '404.not_found' | t }}</p>
      <div class="not-found__actions">
        <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg">{{ '404.go_home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--secondary btn--lg">{{ '404.back_to_shopping' | t }}</a>
      </div>

      <form action="{{ routes.search_url }}" method="get" class="not-found__search" role="search">
        <input type="hidden" name="type" value="product">
        <div style="display:flex;gap:0.75rem;max-width:480px;margin:0 auto;">
          <label class="sr-only" for="NotFoundSearch">{{ 'general.search.title' | t }}</label>
          <input
            id="NotFoundSearch"
            class="form-input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.placeholder' | t }}"
            autocomplete="off"
          >
          <button type="submit" class="btn btn--primary" aria-label="{{ 'general.search.title' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "404 page",
  "settings": []
}
{% endschema %}
