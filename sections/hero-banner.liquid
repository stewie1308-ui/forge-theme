<section
  class="hero{% if section.settings.full_height %} hero--full{% endif %}"
  style="
    --hero-bg: {{ section.settings.background_color }};
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    min-height: {{ section.settings.min_height }}px;
  "
>

  {%- if section.settings.image != blank -%}
    <div class="hero__media" aria-hidden="true">
      <img
        class="hero__img"
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image.alt | default: '' | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        sizes="100vw"
        srcset="
          {{ section.settings.image | image_url: width: 800  }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
      >
    </div>
  {%- elsif section.settings.video != blank -%}
    {%- liquid
      assign hero_video  = section.settings.video
      assign hero_poster = section.settings.video_poster | default: hero_video.preview_image
    -%}
    <div class="hero__media" aria-hidden="true">
      <video
        id="HeroVideo-{{ section.id }}"
        class="hero__img"
        muted
        loop
        playsinline
        preload="metadata"
        {% if hero_poster != blank %}poster="{{ hero_poster | image_url: width: 1600 }}"{% endif %}
      >
        {%- for source in hero_video.sources -%}
          {%- if source.format == 'mp4' -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endif -%}
        {%- endfor -%}
      </video>
    </div>
    <script>
      (function () {
        /* No autoplay attribute: it cannot be undone from CSS, so the
           prefers-reduced-motion rule in theme.css can stop the animations but not
           the video. Start playback here instead, and leave the poster in place for
           anyone who has asked for reduced motion. */
        var video = document.getElementById('HeroVideo-{{ section.id }}');
        if (!video) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var playing = video.play();
        if (playing) playing.catch(function () {});
      })();
    </script>
  {%- elsif section.settings.use_bundled_image -%}
    {%- comment -%}
      An image_picker can only read the store's Files, so a theme cannot ship a
      selectable hero image. This falls back to one bundled in assets/ instead.
      Untick the setting for a plain background_color hero.
    {%- endcomment -%}
    <div class="hero__media" aria-hidden="true">
      <img
        class="hero__img"
        src="{{ 'hero-banner.webp' | asset_url }}"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="1536"
        height="1024"
      >
    </div>
  {%- endif -%}

  {%- if section.settings.image != blank or section.settings.video != blank or section.settings.use_bundled_image -%}
    <div class="hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero__content container">
    <div class="hero__inner hero__inner--{{ section.settings.content_alignment }}">

      {%- if section.settings.eyebrow != blank -%}
        <span class="hero__eyebrow reveal">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading reveal">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub reveal">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="hero__buttons reveal">
          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="btn btn--{{ section.settings.button_style }} btn--lg"
            >
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              href="{{ section.settings.button_link_2 | default: '#' }}"
              class="btn btn--{{ section.settings.button_style_2 }} btn--lg"
            >
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.trust_bar != blank -%}
        <p class="hero__trust reveal">{{ section.settings.trust_bar }}</p>
      {%- endif -%}

    </div>
  </div>

</section>


{% schema %}
{
  "name": "t:sections.hero-banner.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero-banner.settings.header__1.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero-banner.settings.image.label"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.hero-banner.settings.video.label",
      "info": "t:sections.hero-banner.settings.video.info"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "t:sections.hero-banner.settings.video_poster.label",
      "info": "t:sections.hero-banner.settings.video_poster.info"
    },
    {
      "type": "checkbox",
      "id": "use_bundled_image",
      "label": "t:sections.hero-banner.settings.use_bundled_image.label",
      "info": "t:sections.hero-banner.settings.use_bundled_image.info",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.hero-banner.settings.background_color.label",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero-banner.settings.overlay_opacity.label",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.hero-banner.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:sections.hero-banner.settings.min_height.label",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "t:sections.hero-banner.settings.full_height.label",
      "default": false
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.hero-banner.settings.content_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero-banner.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.hero-banner.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.hero-banner.settings.content_alignment.options__3.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.hero-banner.settings.header__3.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero-banner.settings.eyebrow.label",
      "default": "New formula"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.hero-banner.settings.heading.label",
      "default": "Built for people who actually train."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.hero-banner.settings.subheading.label",
      "default": "Science-backed supplements formulated for real results — not marketing claims."
    },
    {
      "type": "text",
      "id": "trust_bar",
      "label": "t:sections.hero-banner.settings.trust_bar.label",
      "info": "t:sections.hero-banner.settings.trust_bar.info",
      "placeholder": "t:sections.hero-banner.settings.trust_bar.placeholder"
    },
    {
      "type": "header",
      "content": "t:sections.hero-banner.settings.header__4.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero-banner.settings.button_label.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-banner.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.hero-banner.settings.button_style.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.hero-banner.settings.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.hero-banner.settings.button_style.options__2.label"
        },
        {
          "value": "accent",
          "label": "t:sections.hero-banner.settings.button_style.options__3.label"
        }
      ],
      "default": "accent"
    },
    {
      "type": "header",
      "content": "t:sections.hero-banner.settings.header__5.content"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.hero-banner.settings.button_label_2.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.hero-banner.settings.button_link_2.label"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "t:sections.hero-banner.settings.button_style_2.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.hero-banner.settings.button_style_2.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.hero-banner.settings.button_style_2.options__2.label"
        },
        {
          "value": "accent",
          "label": "t:sections.hero-banner.settings.button_style_2.options__3.label"
        }
      ],
      "default": "secondary"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-banner.presets.name"
    }
  ]
}
{% endschema %}
