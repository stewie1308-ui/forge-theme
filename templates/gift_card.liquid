{% layout none %}
{%- comment -%}
  Gift card template. Rendered on its own (no theme layout) so the
  card can be printed or saved cleanly.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ 'gift_card.card' | t }} — {{ shop.name }}</title>
  <meta name="robots" content="noindex, nofollow">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    .giftcard-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
      background: var(--color-background-secondary);
    }
    .giftcard {
      width: 100%;
      max-width: 440px;
      background: var(--color-background);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      text-align: center;
      box-shadow: var(--shadow-lg);
    }
    .giftcard__shop {
      font-family: var(--font-heading-family);
      font-weight: var(--font-heading-weight);
      font-size: var(--text-xl);
      margin-bottom: 0.5rem;
    }
    .giftcard__label {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-foreground-muted);
      margin-bottom: 2rem;
    }
    .giftcard__balance {
      font-family: var(--font-heading-family);
      font-size: var(--text-4xl);
      line-height: 1.1;
      margin-bottom: 0.5rem;
    }
    .giftcard__initial {
      font-size: var(--text-sm);
      color: var(--color-foreground-muted);
      margin-bottom: 2rem;
    }
    .giftcard__code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: var(--text-lg);
      letter-spacing: 0.12em;
      padding: 0.875rem 1rem;
      border: 2px dashed var(--color-border-strong);
      border-radius: var(--radius-md);
      word-break: break-all;
      margin-bottom: 0.75rem;
    }
    .giftcard__hint,
    .giftcard__expiry {
      font-size: var(--text-sm);
      color: var(--color-foreground-muted);
      margin-bottom: 1.5rem;
    }
    .giftcard__status {
      background: var(--color-background-secondary);
      border-radius: var(--radius-md);
      padding: 0.875rem;
      font-size: var(--text-sm);
      font-weight: var(--font-weight-bold);
      margin-bottom: 1.5rem;
    }
    .giftcard__wallet img { max-width: 140px; height: auto; }
    @media print {
      .giftcard-page { background: #fff; padding: 0; }
      .giftcard { box-shadow: none; }
      .giftcard__actions { display: none; }
    }
  </style>
</head>

<body class="template-gift-card">
  <div class="giftcard-page">
    <div class="giftcard">

      <p class="giftcard__shop">{{ shop.name }}</p>
      <p class="giftcard__label">{{ 'gift_card.card' | t }}</p>

      {%- if gift_card.expired or gift_card.balance == 0 -%}
        <p class="giftcard__status">
          {%- if gift_card.balance == 0 -%}
            {{ 'gift_card.used' | t }}
          {%- else -%}
            {{ 'gift_card.expired' | t }}
          {%- endif -%}
        </p>
      {%- endif -%}

      <p class="giftcard__balance">{{ gift_card.balance | money }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="giftcard__initial">
          {%- assign gc_balance = gift_card.balance | money -%}
          {{ 'gift_card.remaining_html' | t: balance: gc_balance }}
        </p>
      {%- endif -%}

      <p class="giftcard__code">{{ gift_card.code | format_code }}</p>
      <p class="giftcard__hint">{{ 'gift_card.use_at_checkout' | t }}</p>

      {%- if gift_card.expires_on and gift_card.expired == false -%}
        <p class="giftcard__expiry">
          {%- assign gc_expiry = gift_card.expires_on | date: format: 'date' -%}
          {{ 'gift_card.expires_on' | t: expires_on: gc_expiry }}
        </p>
      {%- endif -%}

      <div class="giftcard__actions">
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="giftcard__wallet">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                 alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                 width="140" height="43">
          </a>
        {%- endif -%}

        <a href="{{ shop.url }}" class="btn btn--secondary btn--full mt-4" style="display:flex;">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>

    </div>
  </div>
</body>
</html>
