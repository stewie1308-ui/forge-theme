<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ shop.name }}</title>
  {%- if shop.description != blank -%}
    <meta name="description" content="{{ shop.description | strip_html | escape }}">
  {%- endif -%}

  {{ content_for_header }}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- liquid
    assign body_font    = settings.type_body_font
    assign heading_font = settings.type_header_font
  -%}

  {%- style -%}
    {{ body_font    | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}

    :root {
      --font-body-family:    {{ body_font.family | json }}, {{ body_font.fallback_families }};
      --font-body-weight:    {{ body_font.weight }};
      --font-heading-family: {{ heading_font.family | json }}, {{ heading_font.fallback_families }};
      --font-heading-weight: {{ heading_font.weight }};
      --font-heading-style:  {{ heading_font.style }};

      --color-background:           {{ settings.color_background }};
      --color-background-secondary: {{ settings.color_background_secondary }};
      --color-foreground:           {{ settings.color_foreground }};
      --color-foreground-muted:     {{ settings.color_foreground_muted }};
      --color-accent:               {{ settings.color_accent }};
      --color-accent-light:         {{ settings.color_accent_light }};
      --color-accent-highlight:     {{ settings.color_accent_highlight }};

      --color-button:                  {{ settings.color_button }};
      --color-button-text:             {{ settings.color_button_text }};
      --color-button-hover:            {{ settings.color_button_hover }};
      --color-button-secondary-text:   {{ settings.color_button_secondary_text }};
      --color-button-secondary-border: {{ settings.color_button_secondary_border }};

      --radius-sm: {{ settings.border_radius_small }}px;
      --radius-md: {{ settings.border_radius_medium }}px;
      --radius-lg: {{ settings.border_radius_large }}px;
    }
  {%- endstyle -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>

<body class="template-password">
  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
